# vps-prod.env — constantes VPS production (pas de secrets, juste la topologie)
# Source: . ops-tools/infra/vps-prod.env

VPS_HOST=seo-prod
VPS_DEPLOY_PATH=/opt/seo-empire
VPS_BACKUP_PATH=/opt/backups

# Containers
N8N_CONTAINER=prod-n8n
N8N_POSTGRES_CONTAINER=prod-n8n-postgres
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_DB=n8n

SEO_DIRECTUS_CONTAINER=prod-seo-directus
SEO_POSTGRES_CONTAINER=prod-seo-postgres
SEO_POSTGRES_USER=seouser
SEO_POSTGRES_DB=seo_empire

SEO_QDRANT_CONTAINER=prod-seo-qdrant
SEO_REDIS_CONTAINER=prod-seo-redis
SEO_TRAEFIK_CONTAINER=prod-traefik
SEO_AGENTS_CONTAINER=prod-seo-agents
